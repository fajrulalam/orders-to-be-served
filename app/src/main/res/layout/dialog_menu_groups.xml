<?xml version="1.0" encoding="utf-8"?>
<!-- Group picker. The ScrollView uses height 0 + weight 1 so the dialog wraps a short
     list but shrinks the list (keeping the buttons on screen) when it is long. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/confirm_dialog_bg"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grup Menu"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pilih grup untuk memfilter pesanan. Grup berlaku di semua tablet dapur."
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/groupListStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="15sp"
        android:textColor="#6B7280"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/groupListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btnCloseGroups"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/confirm_btn_cancel_bg"
            android:gravity="center"
            android:text="Tutup"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="12dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/btnNewGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_btn_primary_blue_bg"
            android:gravity="center"
            android:text="+ Grup baru"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</LinearLayout>
